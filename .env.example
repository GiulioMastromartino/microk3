# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=127.0.0.1
FLASK_PORT=5050

# Security (REQUIRED - Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here-generate-a-real-one

# Authentication (Change these!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Data Storage
DATA_FILE=data/system_data.json

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ROS / Renode bridge
ROS_DOMAIN_ID=0
RENODE_NODE_ID=755
RENODE_NODE_NAME=renode-stm32h755
RENODE_HEARTBEAT_TOPIC=heartbeat
RENODE_HEARTBEAT_TIMEOUT_SEC=5.0

# SSH terminal (disabled by default; HTTPS and known-hosts verification are required)
SSH_TERMINAL_ENABLED=false
SSH_TERMINAL_HOST=
SSH_TERMINAL_PORT=22
SSH_TERMINAL_USERNAME=
SSH_TERMINAL_AUTH_METHOD=key
SSH_TERMINAL_KEY_PATH_HOST=/secure/path/microk3_terminal_key
SSH_TERMINAL_KNOWN_HOSTS_PATH_HOST=/secure/path/microk3_terminal_known_hosts
SSH_TERMINAL_IDLE_TIMEOUT_SEC=1800
# Set to 1 only behind one trusted TLS reverse proxy.
TRUSTED_PROXY_HOPS=0
